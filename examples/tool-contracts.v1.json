{
  "ticket.create": {
    "additionalProperties": false,
    "properties": {
      "title": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Title",
        "type": "string"
      },
      "user_id": {
        "default": "employee-1",
        "title": "User Id",
        "type": "string"
      }
    },
    "required": [
      "title"
    ],
    "title": "CreateTicket",
    "type": "object"
  },
  "ticket.read": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "title": "ReadTicket",
    "type": "object"
  },
  "ticket.update": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      },
      "status": {
        "pattern": "^(open|in_progress|resolved)$",
        "title": "Status",
        "type": "string"
      }
    },
    "required": [
      "id",
      "status"
    ],
    "title": "UpdateTicket",
    "type": "object"
  },
  "user.read": {
    "additionalProperties": false,
    "properties": {
      "id": {
        "title": "Id",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "title": "ReadTicket",
    "type": "object"
  },
  "document.search": {
    "additionalProperties": false,
    "properties": {
      "query": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Query",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "Search",
    "type": "object"
  }
